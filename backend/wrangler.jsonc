{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "askaribank-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-05-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "askaribank-db",
      "database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}